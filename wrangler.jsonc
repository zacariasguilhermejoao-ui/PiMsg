{
  "name": "pimsg-api",
  "main": "src/index.js",
  "vars": { "FIREBASE_PROJECT_ID": "pimsg-c29f1" },
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["*/5 * * * *"] },
  "routes": [
    { "pattern": "pimsg.tchilopop.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pimsg-db",
      "database_id": "22bfe30d-ac68-4111-8d0d-bbb8e7b03633",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "pimsg-media" }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
